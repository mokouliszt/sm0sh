[Unit]
Description=SLMP command mailbox
After=network.target

[Service]
Type=simple
User=sm0sh
Group=sm0sh
WorkingDirectory=/var/lib/sm0sh
ExecStart=/usr/local/bin/sm0sh --config /etc/sm0sh/sm0sh.toml
Restart=on-failure
RestartSec=3
TimeoutStopSec=5
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sm0sh
UMask=0077

[Install]
WantedBy=multi-user.target

